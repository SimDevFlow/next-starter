# FastAPI backend origin. Server-only: used inside Next.js Route Handlers
# (src/app/api/**) which act as a BFF, never imported by client code.
API_BASE_URL=http://localhost:8000

# Same-origin path RTK Query calls from the browser (src/services/api.ts).
# This app proxies it to API_BASE_URL server-side, so it should normally
# stay a relative path and not need to change between environments.
NEXT_PUBLIC_INTERN_BASE_URL=/api/admin

# Video lessons (Cloudflare Stream). Inlined at build time: keep false until the
# backend has STREAMING_ENABLED=true, then rebuild.
NEXT_PUBLIC_STREAMING_ENABLED=false
